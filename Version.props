<?xml version="1.0" encoding="utf-8"?>
<!--
  MissionLedger 버전 정보 (MSBuild)

  저장소 루트의 VERSION 파일(예: "1.0.0")을 읽어 리소스 컴파일러(rc)에
  ML_VERSION_MAJOR / MINOR / PATCH / BUILD 전처리기 정의로 전달합니다.
  -> MLVersion.h -> MissionLedger.rc -> exe 파일 속성의 버전 정보

  - 버전을 바꾸려면 VERSION 파일만 수정합니다. (docs/VERSIONING.md 참고)
  - 빌드 번호는 기본 0이며, CI에서 /p:MLBuildNumber=N 으로 넘길 수 있습니다.
  - C++ 컴파일러(ClCompile)에는 전달하지 않습니다. 버전을 올릴 때마다
    모든 .cpp가 다시 컴파일되는 것을 피하기 위해서입니다.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MLVersionFile>$(MSBuildThisFileDirectory)VERSION</MLVersionFile>
    <MLVersion Condition="Exists('$(MLVersionFile)')">$([System.IO.File]::ReadAllText('$(MLVersionFile)').Trim())</MLVersion>
    <MLVersionValid>false</MLVersionValid>
    <MLVersionValid Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MLVersion)', '^\d+\.\d+\.\d+$'))">true</MLVersionValid>
    <MLBuildNumber Condition="'$(MLBuildNumber)' == ''">0</MLBuildNumber>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MLVersionValid)' == 'true'">
    <MLVersionMajor>$([System.Version]::Parse('$(MLVersion)').Major)</MLVersionMajor>
    <MLVersionMinor>$([System.Version]::Parse('$(MLVersion)').Minor)</MLVersionMinor>
    <MLVersionPatch>$([System.Version]::Parse('$(MLVersion)').Build)</MLVersionPatch>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MLVersionValid)' == 'true'">
    <ResourceCompile>
      <PreprocessorDefinitions>ML_VERSION_MAJOR=$(MLVersionMajor);ML_VERSION_MINOR=$(MLVersionMinor);ML_VERSION_PATCH=$(MLVersionPatch);ML_VERSION_BUILD=$(MLBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <Target Name="MLValidateVersion" BeforeTargets="PrepareForBuild" Condition="'$(MLVersionValid)' != 'true'">
    <Error Text="VERSION 파일이 없거나 형식이 잘못되었습니다. MAJOR.MINOR.PATCH 형식(예: 1.0.0)이어야 합니다. 파일: $(MLVersionFile), 읽은 값: '$(MLVersion)'" />
  </Target>
</Project>
