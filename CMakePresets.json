{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio 2022, x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos",
      "displayName": "macOS (Xcode)",
      "description": "MissionLedger.app + CLI. Minimum macOS 11.0 (Big Sur); without it the minimum is the build Mac's SDK version",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": { "ML_BUILD_GUI": "ON", "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug",     "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release",   "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-installer", "configurePreset": "windows", "configuration": "Release", "targets": [ "installer" ] },
    { "name": "macos-debug",       "configurePreset": "macos",   "configuration": "Debug" },
    { "name": "macos-release",     "configurePreset": "macos",   "configuration": "Release" },
    { "name": "macos-installer",   "configurePreset": "macos",   "configuration": "Release", "targets": [ "installer" ] }
  ],
  "testPresets": [
    { "name": "windows-debug",   "configurePreset": "windows", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-debug",     "configurePreset": "macos",   "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "macos-release",   "configurePreset": "macos",   "configuration": "Release", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "windows-release",
      "displayName": "Configure, Release build, smoke test, installer",
      "steps": [
        { "type": "configure", "name": "windows" },
        { "type": "build",     "name": "windows-release" },
        { "type": "test",      "name": "windows-release" },
        { "type": "build",     "name": "windows-installer" }
      ]
    },
    {
      "name": "macos-release",
      "displayName": "Configure, Release build, smoke test, disk image",
      "steps": [
        { "type": "configure", "name": "macos" },
        { "type": "build",     "name": "macos-release" },
        { "type": "test",      "name": "macos-release" },
        { "type": "build",     "name": "macos-installer" }
      ]
    }
  ]
}
